<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>{{{styles}}}</style>
</head>
<body>
  <div class="page">
    <div class="sidebar">
      <div>
        <h1>{{basics.name}}</h1>
        <div class="label">{{basics.label}}</div>
      </div>

      <div class="contact-section">
        <h2>Contact</h2>
        <div class="contact-item">{{basics.email}}</div>
        <div class="contact-item">{{basics.phone}}</div>
        <div class="contact-item">{{basics.location.city}}, {{basics.location.region}}</div>
      </div>

      {{#ifArray skills}}
      <div class="skills-section">
        <h2>Skills</h2>
        {{#each skills}}
        <div class="skill-group">
          <div class="skill-name">{{this.name}}</div>
          <div class="skill-keywords">{{join this.keywords ", "}}</div>
        </div>
        {{/each}}
      </div>
      {{/ifArray}}

      {{#ifArray languages}}
      <div class="languages-section">
        <h2>Languages</h2>
        {{#each languages}}
        <div class="language-item">{{this.language}} <span class="fluency">({{this.fluency}})</span></div>
        {{/each}}
      </div>
      {{/ifArray}}
    </div>

    <div class="main">
      <div class="section">
        <h2>Professional Summary</h2>
        <p class="summary-text">{{basics.summary}}</p>
      </div>

      {{#ifArray work}}
      <div class="section">
        <h2>Work Experience</h2>
        {{#each work}}
        <div class="job">
          <div class="job-header">
            <div>
              <span class="job-title">{{this.position}}</span> <span class="job-company">at {{this.name}}</span>
            </div>
            <div class="job-date">{{dateRange this.startDate this.endDate}}</div>
          </div>
          {{#ifArray this.highlights}}
          <ul class="job-highlights">
            {{#each this.highlights}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
          {{/ifArray}}
        </div>
        {{/each}}
      </div>
      {{/ifArray}}

      {{#ifArray education}}
      <div class="section">
        <h2>Education</h2>
        {{#each education}}
        <div class="edu-item">
          <div class="edu-degree">{{this.studyType}} in {{this.area}}</div>
          <div class="edu-school">{{this.institution}}</div>
          <div class="edu-date">{{formatDate this.endDate}}</div>
        </div>
        {{/each}}
      </div>
      {{/ifArray}}

      {{#ifArray certificates}}
      <div class="section">
        <h2>Certifications</h2>
        {{#each certificates}}
        <div class="edu-item">
          <div class="edu-degree">{{this.name}}</div>
          <div class="edu-school">{{this.issuer}}</div>
          <div class="edu-date">{{formatDate this.date}}</div>
        </div>
        {{/each}}
      </div>
      {{/ifArray}}
    </div>
  </div>
</body>
</html>
