<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{fullName}} - Resume</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: Arial, sans-serif;
            font-size: 11pt;
            line-height: 1.4;
            color: #000;
        }
        .container {
            max-width: 8.5in;
            height: 11in;
            margin: 0 auto;
            padding: 0.75in 0.5in;
            background: white;
        }
        .header {
            margin-bottom: 0.15in;
        }
        .name {
            font-size: 13pt;
            font-weight: bold;
        }
        .contact-info {
            font-size: 10pt;
            margin-top: 2pt;
        }
        .contact-info span {
            margin-right: 15pt;
        }
        .section {
            margin: 0.1in 0;
        }
        .section-title {
            font-size: 11pt;
            font-weight: bold;
            text-transform: uppercase;
            border-bottom: 1px solid #000;
            margin-bottom: 4pt;
            padding-bottom: 2pt;
        }
        .entry {
            margin-bottom: 6pt;
        }
        .entry-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1pt;
        }
        .entry-title {
            font-weight: bold;
            font-size: 10.5pt;
        }
        .entry-date {
            font-size: 10pt;
            text-align: right;
        }
        .entry-subtitle {
            font-size: 10pt;
            margin-bottom: 2pt;
        }
        .bullet-list {
            margin-left: 15pt;
            list-style-type: disc;
        }
        .bullet-list li {
            margin-bottom: 1pt;
            font-size: 10pt;
        }
        .skills {
            font-size: 10.5pt;
            line-height: 1.3;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div class="name">{{fullName}}</div>
            <div class="contact-info">
                {{#if email}}<span>{{email}}</span>{{/if}}
                {{#if phone}}<span>{{phone}}</span>{{/if}}
                {{#if location}}<span>{{location}}</span>{{/if}}
            </div>
        </div>

        <!-- Professional Summary -->
        {{#if tailoredSummary}}
        <div class="section">
            <div class="section-title">Summary</div>
            <p style="font-size: 10.5pt;">{{tailoredSummary}}</p>
        </div>
        {{/if}}

        <!-- Experience -->
        {{#if tailoredExperience}}
        <div class="section">
            <div class="section-title">Experience</div>
            {{#each tailoredExperience}}
            <div class="entry">
                <div class="entry-header">
                    <span class="entry-title">{{this.title}}</span>
                    <span class="entry-date">{{this.duration}}</span>
                </div>
                <div class="entry-subtitle">{{this.company}}</div>
                {{#if this.achievements}}
                <ul class="bullet-list">
                    {{#each this.achievements}}
                    <li>{{this}}</li>
                    {{/each}}
                </ul>
                {{/if}}
            </div>
            {{/each}}
        </div>
        {{/if}}

        <!-- Education -->
        {{#if tailoredEducation}}
        <div class="section">
            <div class="section-title">Education</div>
            {{#each tailoredEducation}}
            <div class="entry">
                <div class="entry-header">
                    <span class="entry-title">{{this.degree}}{{#if this.field}} in {{this.field}}{{/if}}</span>
                    <span class="entry-date">{{this.year}}</span>
                </div>
                <div class="entry-subtitle">{{this.institution}}</div>
            </div>
            {{/each}}
        </div>
        {{/if}}

        <!-- Skills -->
        {{#if tailoredSkills}}
        <div class="section">
            <div class="section-title">Skills</div>
            <div class="skills">
                {{#each tailoredSkills}}{{#if @index}}, {{/if}}{{this}}{{/each}}
            </div>
        </div>
        {{/if}}
    </div>
</body>
</html>
