<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>{{{styles}}}</style>
</head>
<body>
  <div class="page">
    <aside class="sidebar">
      <div class="sidebar-name">
        <h1>{{basics.name}}</h1>
        <div class="label">{{basics.label}}</div>
      </div>

      <div class="sidebar-section">
        <h2>Contact</h2>
        <div class="contact-item">{{basics.email}}</div>
        <div class="contact-item">{{basics.phone}}</div>
        <div class="contact-item">{{basics.location.city}}, {{basics.location.region}}</div>
      </div>

      {{#ifArray skills}}
      <div class="sidebar-section">
        <h2>Skills</h2>
        <div class="skills-list">
          {{#each skills}}
          {{#each this.keywords}}
          <span class="skill-pill">{{this}}</span>
          {{/each}}
          {{/each}}
        </div>
      </div>
      {{/ifArray}}

      {{#ifArray languages}}
      <div class="sidebar-section">
        <h2>Languages</h2>
        {{#each languages}}
        <div class="contact-item">{{this.language}} <span class="fluency">({{this.fluency}})</span></div>
        {{/each}}
      </div>
      {{/ifArray}}
    </aside>

    <main class="content">
      <div class="section">
        <h2>About</h2>
        <p class="summary-text">{{basics.summary}}</p>
      </div>

      {{#ifArray work}}
      <div class="section">
        <h2>Experience</h2>
        {{#each work}}
        <div class="job">
          <div class="job-header">
            <span class="job-title">{{this.position}}</span>
            <span class="job-date">{{dateRange this.startDate this.endDate}}</span>
          </div>
          <div class="job-company">{{this.name}}</div>
          {{#ifArray this.highlights}}
          <ul class="job-highlights">
            {{#each this.highlights}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
          {{/ifArray}}
        </div>
        {{/each}}
      </div>
      {{/ifArray}}

      {{#ifArray education}}
      <div class="section">
        <h2>Education</h2>
        {{#each education}}
        <div class="edu-item">
          <div class="edu-degree">{{this.studyType}} in {{this.area}}</div>
          <div class="edu-school">{{this.institution}} &bull; {{formatDate this.endDate}}</div>
        </div>
        {{/each}}
      </div>
      {{/ifArray}}

      {{#ifArray certificates}}
      <div class="section">
        <h2>Certifications</h2>
        {{#each certificates}}
        <div class="edu-item">
          <div class="edu-degree">{{this.name}}</div>
          <div class="edu-school">{{this.issuer}} &bull; {{formatDate this.date}}</div>
        </div>
        {{/each}}
      </div>
      {{/ifArray}}
    </main>
  </div>
</body>
</html>
