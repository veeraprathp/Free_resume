<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>{{{styles}}}</style>
</head>
<body>
  <div class="page">
    <div class="header">
      <img src="{{basics.image}}" alt="{{basics.name}}" class="photo">
      <div class="header-info">
        <h1>{{basics.name}}</h1>
        <div class="label">{{basics.label}}</div>
      </div>
    </div>

    <div class="contact-line">
      {{basics.email}} &bull; {{basics.phone}} &bull; {{basics.location.city}}, {{basics.location.region}}
    </div>

    <hr class="divider">

    <div class="section">
      <h2>Summary</h2>
      <p class="summary-text">{{basics.summary}}</p>
    </div>

    <hr class="divider">

    {{#ifArray work}}
    <div class="section">
      <h2>Experience</h2>
      {{#each work}}
      <div class="job">
        <div class="job-header">
          <div>
            <span class="job-title">{{this.position}}</span> <span class="job-company">at {{this.name}}</span>
          </div>
          <div class="job-date">{{dateRange this.startDate this.endDate}}</div>
        </div>
        {{#ifArray this.highlights}}
        <ul class="job-highlights">
          {{#each this.highlights}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
        {{/ifArray}}
      </div>
      {{/each}}
    </div>

    <hr class="divider">
    {{/ifArray}}

    {{#ifArray education}}
    <div class="section">
      <h2>Education</h2>
      {{#each education}}
      <div class="edu-item">
        <div class="edu-degree">{{this.studyType}} in {{this.area}}</div>
        <div class="edu-school">{{this.institution}}</div>
        <div class="edu-date">{{formatDate this.endDate}}</div>
      </div>
      {{/each}}
    </div>

    <hr class="divider">
    {{/ifArray}}

    {{#ifArray certificates}}
    <div class="section">
      <h2>Certifications</h2>
      {{#each certificates}}
      <div class="edu-item">
        <div class="edu-degree">{{this.name}}</div>
        <div class="edu-school">{{this.issuer}}</div>
        <div class="edu-date">{{formatDate this.date}}</div>
      </div>
      {{/each}}
    </div>

    <hr class="divider">
    {{/ifArray}}

    {{#ifArray skills}}
    <div class="section">
      <h2>Skills</h2>
      {{#each skills}}
      <div class="skill-line"><strong>{{this.name}}:</strong> {{join this.keywords ", "}}</div>
      {{/each}}
    </div>

    <hr class="divider">
    {{/ifArray}}

    {{#ifArray languages}}
    <div class="section">
      <h2>Languages</h2>
      {{#each languages}}
      <span class="language-item">{{this.language}} ({{this.fluency}})</span>
      {{/each}}
    </div>
    {{/ifArray}}
  </div>
</body>
</html>
